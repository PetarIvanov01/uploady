{
  "name": "uplody",
  "private": true,
  "packageManager": "npm@11.16.0",
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "check": "npm run lint && npm run check-types",
    "check-types": "tsc -b",
    "dev": "turbo run dev",
    "dev:api": "npm run dev --workspace @uploady/api",
    "dev:web": "npm run dev --workspace @uploady/web",
    "db:generate": "npm run db:generate --workspace @uploady/api",
    "db:migrate": "npm run db:migrate --workspace @uploady/api",
    "db:push": "npm run db:push --workspace @uploady/api",
    "db:studio": "npm run db:studio --workspace @uploady/api",
    "docker:build": "docker build --file apps/api/Dockerfile --tag uploady-api .",
    "docker:down": "docker compose down",
    "docker:up": "docker compose up --build",
    "dead-code": "knip",
    "dead-code:files": "knip --files",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "turbo run format",
    "prepare": "husky",
    "storage:up": "node ./scripts/storage-up.mjs",
    "test": "turbo run test",
    "test:storage": "docker compose run --build --rm storage-test"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "knip": "^6.32.2",
    "oxlint": "^1.78.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.7.4",
    "turbo": "^2.10.9",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "11.16.0"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
